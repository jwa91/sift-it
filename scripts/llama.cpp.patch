sift-it's change to llama.cpp, applied by scripts/build-llama.sh.

mtmd loads every encoder an mmproj holds. EmbeddingGemma 2's (ggml-org's mmproj-embeddinggemma-2-Q8_0.gguf) holds a
vision and an audio encoder, which mtmd copies into memory of their own: 215 and 312 MiB. use_vision and use_audio in
mtmd_context_params say which to load, so pictures load only the vision encoder and sound only the audio encoder, from
the one file. Both default to true, as before.

diff --git a/tools/mtmd/clip.cpp b/tools/mtmd/clip.cpp
index d204708..9805968 100644
--- a/tools/mtmd/clip.cpp
+++ b/tools/mtmd/clip.cpp
@@ -4321,7 +4321,7 @@ struct clip_init_result clip_init(const char * fname, struct clip_context_params
             ctx_params.progress_callback_user_data);
         bool skip_audio = false;
 
-        if (loader.has_vision) {
+        if (loader.has_vision && ctx_params.use_vision) {
             ctx_vision = new clip_ctx(ctx_params);
             loader.load_hparams(ctx_vision->model, CLIP_MODALITY_VISION);
             loader.load_tensors(*ctx_vision);
@@ -4335,7 +4335,7 @@ struct clip_init_result clip_init(const char * fname, struct clip_context_params
             skip_audio = ctx_vision->model.proj_type == PROJECTOR_TYPE_GEMMA3NV;
         }
 
-        if (loader.has_audio && !skip_audio) {
+        if (loader.has_audio && ctx_params.use_audio && !skip_audio) {
             ctx_audio = new clip_ctx(ctx_params);
             loader.load_hparams(ctx_audio->model, CLIP_MODALITY_AUDIO);
             loader.load_tensors(*ctx_audio);
